# Copy to .env and adjust if needed. Nothing here is a secret -- the
# mock backend requires no credentials -- but the pattern (config via
# env vars, never hard-coded, .env git-ignored) is what a real project
# should follow once real endpoints/API keys are involved.
IDCHECK_BASE_URL=http://127.0.0.1:5005
IDCHECK_API_TIMEOUT=10
IDCHECK_BROWSER=chrome
IDCHECK_HEADLESS=true
IDCHECK_UI_WAIT_TIMEOUT=10
# true: pytest boots mock_server in-process on IDCHECK_BASE_URL.
# false: target an already running server / another environment.
IDCHECK_START_MOCK=true
